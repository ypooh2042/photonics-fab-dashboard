#!/usr/bin/env bash
# Interactively change the viewer/admin login password stored (as a bcrypt
# hash) in apps/web/.env.local, then restarts the web service so it takes
# effect. Requires the current password to match before allowing a change.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$REPO_ROOT/apps/web/.env.local"
SERVICE="fab-dashboard-web.service"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "환경 파일을 찾을 수 없습니다: $ENV_FILE" >&2
  exit 1
fi

echo "어떤 비밀번호를 변경하시겠습니까?"
echo "  1) viewer"
echo "  2) admin"
echo "  3) operator (GPT 랩노트 자동추출 베타 기능용)"
read -rp "선택 (1/2/3): " choice
case "$choice" in
  1) VAR_NAME="VIEWER_PASSWORD_HASH"; LABEL="viewer" ;;
  2) VAR_NAME="ADMIN_PASSWORD_HASH"; LABEL="admin" ;;
  3) VAR_NAME="OPERATOR_PASSWORD_HASH"; LABEL="operator" ;;
  *) echo "1, 2, 3 중에서만 입력할 수 있습니다." >&2; exit 1 ;;
esac

CURRENT_LINE="$(grep -m1 "^${VAR_NAME}=" "$ENV_FILE" || true)"
if [[ -z "$CURRENT_LINE" ]]; then
  echo "$ENV_FILE 에서 ${VAR_NAME}를 찾을 수 없습니다." >&2
  exit 1
fi
CURRENT_HASH_ESCAPED="${CURRENT_LINE#*=}"

read -rsp "기존 ${LABEL} 비밀번호: " OLD_PASSWORD
echo

if ! CURRENT_HASH_ESCAPED="$CURRENT_HASH_ESCAPED" OLD_PASSWORD="$OLD_PASSWORD" node -e '
  const bcrypt = require("bcryptjs");
  const hash = process.env.CURRENT_HASH_ESCAPED.replace(/\\\$/g, "$");
  process.exit(bcrypt.compareSync(process.env.OLD_PASSWORD, hash) ? 0 : 1);
'; then
  unset OLD_PASSWORD
  echo "기존 비밀번호가 올바르지 않습니다." >&2
  exit 1
fi
unset OLD_PASSWORD

read -rsp "새 ${LABEL} 비밀번호: " NEW_PASSWORD1
echo
read -rsp "새 ${LABEL} 비밀번호 확인: " NEW_PASSWORD2
echo

if [[ "$NEW_PASSWORD1" != "$NEW_PASSWORD2" ]]; then
  unset NEW_PASSWORD1 NEW_PASSWORD2
  echo "두 비밀번호가 일치하지 않습니다." >&2
  exit 1
fi
if [[ ${#NEW_PASSWORD1} -lt 8 ]]; then
  unset NEW_PASSWORD1 NEW_PASSWORD2
  echo "비밀번호는 8자 이상이어야 합니다." >&2
  exit 1
fi

cp "$ENV_FILE" "$ENV_FILE.bak"

ENV_FILE="$ENV_FILE" VAR_NAME="$VAR_NAME" NEW_PASSWORD="$NEW_PASSWORD1" node -e '
  const bcrypt = require("bcryptjs");
  const fs = require("fs");
  const envFile = process.env.ENV_FILE;
  const varName = process.env.VAR_NAME;
  const hash = bcrypt.hashSync(process.env.NEW_PASSWORD, 12);
  // dotenv-expand (used by @next/env) treats a bare "$" as variable
  // interpolation syntax, which would corrupt a raw bcrypt hash — escaping
  // every "$" as "\$" here is what makes it survive round-tripping through
  // .env.local unchanged (see the existing VIEWER/ADMIN_PASSWORD_HASH lines).
  const escaped = hash.replace(/\$/g, "\\$");
  const lines = fs.readFileSync(envFile, "utf8").split("\n");
  let found = false;
  const next = lines.map((line) => {
    if (line.startsWith(varName + "=")) {
      found = true;
      return `${varName}=${escaped}`;
    }
    return line;
  });
  if (!found) {
    console.error(`${varName} line not found`);
    process.exit(1);
  }
  fs.writeFileSync(envFile, next.join("\n"));
'
unset NEW_PASSWORD1 NEW_PASSWORD2 NEW_PASSWORD

echo "${LABEL} 비밀번호를 변경했습니다. (백업: $ENV_FILE.bak)"

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
systemctl --user restart "$SERVICE"
sleep 1
if systemctl --user is-active --quiet "$SERVICE"; then
  echo "서비스 재시작 완료 (${SERVICE} active)."
else
  echo "서비스 재시작 후 상태 확인 필요: systemctl --user status ${SERVICE}" >&2
  exit 1
fi
